#!/usr/bin/env bash
# Uploads a built coeus to the cache and pins it, so the cache's garbage collection
# keeps it: coeus-<system> names the newest build, and three rotating revision pins
# keep the builds before it for hosts that have not updated yet.
set -euo pipefail

if [[ $# -ne 2 ]]; then
  printf 'usage: %s <system> <store-path>\n' "$0" >&2
  exit 64
fi

case "$1" in
  x86_64-linux|aarch64-linux|aarch64-darwin) ;;
  *) printf 'unsupported system: %s\n' "$1" >&2; exit 64 ;;
esac

: "${NIKS3_BIN:?missing niks3 binary}"
: "${NIKS3_AUTH_TOKEN_SCRIPT:?missing OIDC token command}"
: "${NIKS3_SERVER_URL:?missing cache URL}"

pin_name="coeus-$1"
store_path=$2
auth=(--server-url "$NIKS3_SERVER_URL" --auth-token-script "$NIKS3_AUTH_TOKEN_SCRIPT")

# Reuse a slot on retries, otherwise replace the oldest of three revision pins. Fixed
# names bound retention without granting CI permission to delete pins.
pins=$("$NIKS3_BIN" pins list "${auth[@]}" --json)
revision_pin=$(jq -er --arg prefix "$pin_name" --arg path "$store_path" '
  [range(1; 4) | "\($prefix).revision-\(.)"] as $slots
  | (. // []) as $pins
  | ($pins | map(select(.name as $name | $slots | index($name)))) as $revisions
  | ($revisions | map(select(.store_path == $path)) | first | .name)
    // ($slots - ($revisions | map(.name)) | first)
    // ($revisions | min_by(.updated_at) | .name)
' <<< "$pins")

# Upload before moving the public pin.
"$NIKS3_BIN" push "${auth[@]}" --max-concurrent-uploads 2 --pin "$revision_pin" "$store_path"
"$NIKS3_BIN" pins create "${auth[@]}" "$pin_name" "$store_path"
nix path-info --refresh --store "$NIKS3_SERVER_URL" "$store_path"

pins=$("$NIKS3_BIN" pins list "${auth[@]}" --json)
jq -e --arg name "$pin_name" --arg path "$store_path" '
  any(.[]; .name == $name and .store_path == $path)
' <<< "$pins" > /dev/null
